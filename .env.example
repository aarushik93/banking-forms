# Copy to .env and adjust. Everything has safe defaults for local development.

# --- Runtime ---
# dev | test | prod  (prod refuses to boot with mock KYC, console email, or a weak admin token)
ENV=dev

# --- Database (docker compose) ---
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank
POSTGRES_DB=bankforms

# --- Admin back office ---
# Token required by /api/v1/admin/* and the /admin UI. Use a long random value in prod.
ADMIN_API_TOKEN=change-me

# --- Identity verification (KYC) ---
# idmatrix  -> Equifax IDMatrix adapter (SOAP). Docker Compose defaults point it at the
#              bundled mock IDMatrix service, so the full integration runs locally with
#              no Equifax access. Surnames "Refer"/"Reject"/"Fault" trigger those outcomes.
# mock      -> in-process deterministic provider (no HTTP; used by the test suite)
# experian  -> Experian CrossCore via the EXPERIAN_* credentials below
KYC_PROVIDER=idmatrix

# Equifax IDMatrix. Real endpoints: test https://ctaau.vedaxml.com/cta/sys2/idmatrix-v4,
# production https://vedaxml.com/sys2/idmatrix-v4. With real access, set the URL and the
# credentials from your Equifax account manager; otherwise compose supplies the mock's
# defaults (http://idmatrix-mock:8700/... with idm-demo credentials).
#IDMATRIX_URL=https://ctaau.vedaxml.com/cta/sys2/idmatrix-v4
#IDMATRIX_USERNAME=
#IDMATRIX_PASSWORD=
IDMATRIX_REASON_FOR_ENQUIRY=Account opening

# Experian CrossCore (Australia): sandbox-api.experian.com.au / api.experian.com.au
EXPERIAN_BASE_URL=https://sandbox-api.experian.com.au
EXPERIAN_CLIENT_ID=
EXPERIAN_CLIENT_SECRET=
EXPERIAN_USERNAME=
EXPERIAN_PASSWORD=

# --- Email ---
# console  -> log emails instead of sending (local/dev)
# resend   -> real delivery via Resend (RESEND_API_KEY). Until a sending domain is
#             verified in Resend, EMAIL_FROM must be onboarding@resend.dev and the
#             free tier only delivers to the account owner's address.
# sendgrid -> real delivery via SendGrid (SENDGRID_API_KEY)
EMAIL_PROVIDER=console
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=investments@example-bank.test
EMAIL_FROM_NAME=Example Bank Investments

# --- Ports (host side) ---
BACKEND_PORT=8000

# --- Lookups & verification ---
# BSB directory: fetched live from AusPayNet's permanent public URL and cached in
# memory (daily refresh). BSB_STRICT=true rejects unknown BSBs at submit (skipped
# automatically if the directory is unreachable).
#BSB_DIRECTORY_URL=https://auspaynetbsbpublic.blob.core.windows.net/bsb-reports/BSBDirectoryFull.csv
BSB_STRICT=true

# Address autocomplete: nominatim (keyless OSM — dev/demo only, not licensed for
# production traffic) | geoscape (production; needs GEOSCAPE_API_KEY) | off
ADDRESS_PROVIDER=nominatim
GEOSCAPE_API_KEY=

# Account ownership verification: mock (dev: account numbers ending 99 -> no match,
# 88 -> partial, 77 -> provider outage) | off. Real options (CDR / PayID name
# matching) need accreditation — wire a vendor adapter in
# backend/app/adapters/account_verification.py when contracted.
ACCOUNT_VERIFICATION_PROVIDER=mock

# --- API hardening ---
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
RATE_LIMIT_PER_MINUTE=30
